@page "/"
@inject CircuitService CircuitService
@inject HttpClient Http

<div class="sidebar">
    <div class="sidebar-section">
        <h3>Components</h3>
        <div class="header-actions" style="padding: 0.5rem;">
            <label class="btn btn-primary" style="cursor: pointer;">
                📥 Load XML
                <InputFile OnChange="OnFileSelected" accept=".xml" style="display: none;" />
            </label>
        </div>
        <div class="component-list">
            @if (CircuitService.LoadedComponents.Count == 0)
            {
                <div class="empty-state">
                    <p>No components loaded.</p>
                    <p>Click "Load XML" to add component definitions.</p>
                </div>
            }
            else
            {
                @foreach (var component in CircuitService.LoadedComponents)
                {
                    <div class="component-item @(selectedComponent == component ? "selected" : "")"
                         @onclick="() => SelectComponent(component)"
                         @ondblclick="() => AddComponentToCircuit(component)">
                        @component.ComponentName
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="canvas-container">
    <div class="canvas-wrapper" style="width: @(canvasWidth)px; height: @(canvasHeight)px;">
        <SKCanvasView @ref="canvasView" 
                      OnPaintSurface="OnPaintSurface"
                      style="width: 100%; height: 100%;"
                      @onpointerdown="OnPointerDown"
                      @onpointermove="OnPointerMove"
                      @onpointerup="OnPointerUp" />
    </div>
</div>

<div class="layers-panel">
    <div class="sidebar-section">
        <h3>Actions</h3>
        <div style="padding: 0.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
            <button class="btn @(isWireMode ? "btn-active" : "btn-secondary")" @onclick="ToggleWireMode">
                ✏️ Wire Mode
            </button>
            <button class="btn btn-secondary" @onclick="ClearCircuit">
                🗑️ Clear
            </button>
        </div>
    </div>
    <div class="sidebar-section" style="flex: 1;">
        <h3>Layers</h3>
        <div class="component-list">
            @if (CircuitService.Circuit.Elements.Count == 0)
            {
                <div class="empty-state">No elements on canvas.</div>
            }
            else
            {
                @foreach (var element in CircuitService.Circuit.Elements)
                {
                    <div class="layer-item">
                        @if (element is PositionalComponent pc)
                        {
                            <span>🔲 @pc.Type.CollectionItem</span>
                        }
                        else if (element is Wire)
                        {
                            <span>〰️ Wire</span>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div style="position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%); 
                background: @(isError ? "#b32121" : "#0e639c"); color: white; 
                padding: 0.75rem 1.5rem; border-radius: 4px; z-index: 1000;">
        @statusMessage
    </div>
}

@code {
    private SKCanvasView? canvasView;
    private ComponentDescription? selectedComponent;
    private int canvasWidth = 800;
    private int canvasHeight = 600;
    private bool isWireMode = false;
    private string? statusMessage;
    private bool isError = false;
    
    // Wire drawing state
    private bool isDrawingWire = false;
    private double wireStartX, wireStartY;

    protected override void OnInitialized()
    {
        CircuitService.OnCircuitChanged += OnCircuitChanged;
    }

    private void OnCircuitChanged()
    {
        canvasView?.Invalidate();
        StateHasChanged();
    }

    private void OnPaintSurface(SKPaintSurfaceEventArgs e)
    {
        CircuitService.RenderToCanvas(e.Surface.Canvas, e.Info.Width, e.Info.Height);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024); // 1MB max
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            if (CircuitService.LoadComponentFromStream(memoryStream, out var componentName, out var errorMessage))
            {
                ShowStatus($"Loaded component: {componentName}");
                StateHasChanged();
            }
            else
            {
                ShowStatus($"Error: {errorMessage}", true);
            }
        }
        catch (Exception ex)
        {
            ShowStatus($"Error loading file: {ex.Message}", true);
        }
    }

    private void SelectComponent(ComponentDescription component)
    {
        selectedComponent = component;
    }

    private void AddComponentToCircuit(ComponentDescription component)
    {
        CircuitService.AddComponentToCircuit(component, canvasWidth / 2, canvasHeight / 2);
        ShowStatus($"Added {component.ComponentName} to circuit");
    }

    private void ToggleWireMode()
    {
        isWireMode = !isWireMode;
        selectedComponent = null;
    }

    private void ClearCircuit()
    {
        CircuitService.ClearCircuit();
        ShowStatus("Circuit cleared");
    }

    private void OnPointerDown(PointerEventArgs e)
    {
        if (isWireMode)
        {
            isDrawingWire = true;
            wireStartX = e.OffsetX;
            wireStartY = e.OffsetY;
        }
        else if (selectedComponent != null)
        {
            CircuitService.AddComponentToCircuit(selectedComponent, e.OffsetX, e.OffsetY);
        }
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        // Could add preview here
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        if (isDrawingWire && isWireMode)
        {
            var start = new CircuitDiagram.Primitives.Point(wireStartX, wireStartY);
            var end = new CircuitDiagram.Primitives.Point(e.OffsetX, e.OffsetY);
            CircuitService.AddWire(start, end);
            isDrawingWire = false;
        }
    }

    private async void ShowStatus(string message, bool error = false)
    {
        statusMessage = message;
        isError = error;
        StateHasChanged();
        
        await Task.Delay(3000);
        statusMessage = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        CircuitService.OnCircuitChanged -= OnCircuitChanged;
    }
}
