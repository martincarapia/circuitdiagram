<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="CircuitDiagram.UI.MainPage">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="300,*,250">
        <!-- Header & Toolbar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*" BackgroundColor="#212121" Padding="10">
            <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center" Margin="0,0,20,0">
                <Image Source="circuitdiagramlogo.png" HeightRequest="32" WidthRequest="32" VerticalOptions="Center" Aspect="AspectFit"/>
                <Label Text="Circuit Diagram" VerticalOptions="Center" FontAttributes="Bold" FontSize="18" TextColor="White"/>
            </HorizontalStackLayout>

            <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Button Text="📥 Load" Clicked="OnLoadComponentClicked" ToolTipProperties.Text="Load a component from XML" TextColor="White" BackgroundColor="Transparent"/>
                    <Button Text="✏️ Wire" Clicked="OnWireModeClicked" ToolTipProperties.Text="Toggle wire drawing mode" TextColor="White" BackgroundColor="Transparent"/>
                    <Button Text="💾 Save" Clicked="OnSaveClicked" ToolTipProperties.Text="Save current circuit" TextColor="White" BackgroundColor="Transparent"/>
                    <Button Text="🔃 Reload" Clicked="OnReloadClicked" ToolTipProperties.Text="Reload from disk" TextColor="White" BackgroundColor="Transparent"/>
                    <Button Text="📂 Import" Clicked="OnImportClicked" ToolTipProperties.Text="Import a circuit file" TextColor="White" BackgroundColor="Transparent"/>
                    <Button Text="📤 Export" Clicked="OnExportClicked" ToolTipProperties.Text="Export to file" TextColor="White" BackgroundColor="Transparent"/>
                    <Button Text="🖼️ Image" Clicked="OnExportImageClicked" ToolTipProperties.Text="Export as PNG image" TextColor="White" BackgroundColor="Transparent"/>
                    <Button Text="🔄 Render" Clicked="OnRenderClicked" ToolTipProperties.Text="Force re-render" TextColor="White" BackgroundColor="Transparent"/>
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>
        
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*">
            <SearchBar x:Name="searchBar" Placeholder="Search components..." TextChanged="OnSearchTextChanged"/>
            <CollectionView x:Name="componentsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnComponentSelected">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="10" HorizontalItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="5" BackgroundColor="White">
                            <Image Source="{Binding Preview}" HeightRequest="60" WidthRequest="60" Aspect="AspectFit"/>
                            <Label Text="{Binding Name}" FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="Black" LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <skia:SKCanvasView x:Name="canvasView" Grid.Row="1" Grid.Column="1" PaintSurface="OnPaintSurface" EnableTouchEvents="True" Touch="OnTouch" />

        <Border Grid.Row="1" Grid.Column="2" Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="#F5F5F5" Margin="0" StrokeShape="RoundRectangle 0">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Grid Grid.Row="0" Padding="10" ColumnDefinitions="Auto,*">
                    <Label Text="📚" VerticalOptions="Center" Margin="0,0,10,0" TextColor="#333333"/>
                    <Label Grid.Column="1" Text="Layers" FontAttributes="Bold" VerticalOptions="Center" TextColor="#333333"/>
                </Grid>
                <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1" Color="#E0E0E0"/>

                <!-- List -->
                <CollectionView x:Name="layersList" Grid.Row="1" BackgroundColor="White" SelectionMode="Multiple" SelectionChanged="OnLayerSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,Auto,*" Padding="5">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#E3F2FD" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Label Text="{Binding ExpandIcon}" VerticalOptions="Center" Margin="{Binding Indentation}" TextColor="#666666" WidthRequest="20" HorizontalTextAlignment="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleExpandCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="1" Text="{Binding Icon}" VerticalOptions="Center" Margin="0,0,5,0" TextColor="Black"/>
                                
                                <Grid Grid.Column="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" TextColor="Black" IsVisible="{Binding IsNotEditing}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="2" Command="{Binding StartEditCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Entry Text="{Binding Name}" TextColor="Black" IsVisible="{Binding IsEditing}" BackgroundColor="White"
                                           ReturnCommand="{Binding FinishEditCommand}" Unfocused="OnRenameEntryUnfocused" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Footer -->
                <BoxView Grid.Row="2" VerticalOptions="Start" HeightRequest="1" Color="#E0E0E0"/>
                <HorizontalStackLayout Grid.Row="2" Padding="10" Spacing="15" HorizontalOptions="Start">
                    <Button Text="🗑️" BackgroundColor="Transparent" TextColor="#666666" 
                            HeightRequest="30" WidthRequest="30" Padding="0"
                            Clicked="OnDeleteSelectedLayerClicked"/>
                    <Button Text="📁" BackgroundColor="Transparent" TextColor="#666666" 
                            HeightRequest="30" WidthRequest="30" Padding="0"
                            Clicked="OnGroupClicked"/>
                    <Button Text="📂" BackgroundColor="Transparent" TextColor="#666666" 
                            HeightRequest="30" WidthRequest="30" Padding="0"/>
                    <Button Text="⧉" BackgroundColor="Transparent" TextColor="#666666" 
                            HeightRequest="30" WidthRequest="30" Padding="0"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
