<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="CircuitDiagram.UI.MainPage">

    <Grid RowDefinitions="Auto,*">
        <HorizontalStackLayout Spacing="10" Margin="10">
            <Button Text="Load Component" Clicked="OnLoadComponentClicked"/>
            <Button Text="Render Circuit" Clicked="OnRenderClicked"/>
        </HorizontalStackLayout>
        <skia:SKCanvasView x:Name="canvasView" Grid.Row="1" PaintSurface="OnPaintSurface" />
    </Grid>

</ContentPage>
